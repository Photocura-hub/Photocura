              "maxalarmvalue": 999.0,
              "minalarmvalue": -999.0,
              "stepvalue": 0.1,
              "decimal": 3,
              "tooltip": "Outer diameter compensation for normal printing layers. A positive value expands the solid, increasing its outer dimensions; a negative value shrinks the solid, decreasing its outer dimensions.",
              "showname": "b",
              "unit": "mm",
              "visible": true,
