            "layergcode": {
              "type": "string",
              "currentvalue": "M6054 {image};show Image\\nG0 Z{rise_pos} F{rise_speed};\\nG0 Z{fall_pos} F{fall_speed};\\nG4 P{light_delay};\\nM106 S{light_pwm};light on\\nG4 P{exposure_time};\\nM106 S0; light off\\n",
